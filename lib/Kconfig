menu "Skywalker Libraries"

config SKYWALKER_LIB_MATRIX
    bool "Matrix"
    select CMSIS_DSP
    select CMSIS_DSP_MATRIX
    select FILE_SYSTEM
    select ZMS
    select FLASH_PAGE_LAYOUT
    select FLASH_MAP
    help
        Enable the Matrix library for matrix operations.

config SKYWALKER_LIB_VOFA
    bool "vofa"
    depends on SERIAL
    help
        Enable the VOFA library for debug

endmenu
