menu "Skywalker Libraries"

config SKYWALKER_LIB_MATRIX
    bool "Matrix"
    select CMSIS_DSP
    select CMSIS_DSP_MATRIX
    help
        Enable the Matrix library for matrix operations.

config SKYWALKER_LIB_MATRIX_STORAGE
    bool "Matrix flash storage"
    depends on SKYWALKER_LIB_MATRIX
    select FILE_SYSTEM
    select ZMS
    select FLASH_PAGE_LAYOUT
    select FLASH_MAP
    help
        Enable flash storage of matrices (matrix_storage_save/read...).
        Requires a flash driver on the board.

config SKYWALKER_LIB_VOFA
    bool "vofa"
    depends on SERIAL && SERIAL_SUPPORT_INTERRUPT
    select UART_INTERRUPT_DRIVEN
    help
        VOFA JustFloat telemetry and line commands over an exclusive UART.
        Uses the interrupt-driven UART API for both hardware USART and
        USB CDC ACM, with a bounded nonblocking frame queue per instance.

config SKYWALKER_LIB_CONTROL
    bool "Pure control algorithms"
    help
        Enable allocation-free PID, feedforward and reference helpers.

config SKYWALKER_LIB_KALMAN_FILTER
    bool "Linear Kalman filter"
    select SKYWALKER_LIB_CONTROL
    select SKYWALKER_LIB_MATRIX
    help
        Enable the CMSIS-DSP linear Kalman algorithm with caller-owned
        buffers and explicit initialization. No devicetree node is needed.

config SKYWALKER_LIB_MOTOR_CONTROL
    bool "C++ velocity and position motor control"
    depends on CPP && SKYWALKER_DRIVER_MOTOR
    depends on SKYWALKER_MOTOR_DJI || SKYWALKER_MOTOR_DM
    select SKYWALKER_LIB_CONTROL
    help
        Enable VelocityMotor/PositionMotor and the enabled motor-family
        backends. Includes feedback checks, timing and fault-stop handling.
        
config SKYWALKER_LIB_COMMUNICATION
    bool "Communication protocols"
    depends on CPP

config SKYWALKER_REMOTE_DR16
    bool "DR16 decoder and input service"
    default y
    depends on SKYWALKER_LIB_COMMUNICATION

config SKYWALKER_REFEREE
    bool "Versioned referee parser"
    default y
    depends on SKYWALKER_LIB_COMMUNICATION

config SKYWALKER_INTERBOARD
    bool "Interboard V1 codec, parser and session"
    default y
    depends on SKYWALKER_LIB_COMMUNICATION

config SKYWALKER_UART_TRANSPORT
    bool "Bounded asynchronous UART transport"
    depends on SKYWALKER_LIB_COMMUNICATION && SERIAL
    select UART_ASYNC_API

config SKYWALKER_INTERBOARD_ENDPOINT
    bool "Interboard endpoint with selectable transport"
    depends on SKYWALKER_INTERBOARD && ENTROPY_GENERATOR
    default y if SKYWALKER_UART_TRANSPORT

config SKYWALKER_INTERBOARD_RS485
    bool "Interboard two-wire RS485 polling transport"
    depends on SKYWALKER_INTERBOARD && SKYWALKER_UART_TRANSPORT && ENTROPY_GENERATOR
    select UART_USE_RUNTIME_CONFIGURE
    help
        Hardware-DE 8N1 UART, one coordinator and one responder. Uses a
        bounded request/reply envelope around the existing interboard frames.

config SKYWALKER_INTERBOARD_CAN
    bool "Interboard segmented classic CAN transport"
    depends on SKYWALKER_INTERBOARD && CAN && ENTROPY_GENERATOR
    help
        Dedicated CAN controller with two directional IDs, bounded packet
        reassembly and controller recovery. Do not share with a motor bus.

config SKYWALKER_REMOTE_RECEIVER
    bool "Threaded DR16 receiver"
    depends on SKYWALKER_REMOTE_DR16 && SKYWALKER_UART_TRANSPORT
    help
        Own an asynchronous UART receive task and publish coherent remote
        snapshots with reader-side expiry and transport diagnostics.

config SKYWALKER_REMOTE_RX_STACK_SIZE
    int "Remote receiver stack size"
    depends on SKYWALKER_REMOTE_RECEIVER
    default 3072
    range 1024 16384

config SKYWALKER_REMOTE_RX_PRIORITY
    int "Remote receiver thread priority"
    depends on SKYWALKER_REMOTE_RECEIVER
    default 6
    range 0 15

config SKYWALKER_LIB_ROBOTICS
    bool "Robot decision and subsystem algorithms"
    depends on CPP
    select SKYWALKER_LIB_CONTROL

config SKYWALKER_ROBOTICS_COMMAND
    bool "Manual mapper and command arbitration"
    default y
    depends on SKYWALKER_LIB_ROBOTICS

config SKYWALKER_COMMAND_SERVICE
    bool "Registered command sources and background arbitration"
    depends on SKYWALKER_ROBOTICS_COMMAND
    help
        Own a command worker and publish non-consuming snapshots.
        Register static-lifetime input and permission sources before start.

config SKYWALKER_COMMAND_STACK_SIZE
    int "Command service stack bytes"
    depends on SKYWALKER_COMMAND_SERVICE
    default 6144
    range 2048 16384

config SKYWALKER_COMMAND_PRIORITY
    int "Command service priority"
    depends on SKYWALKER_COMMAND_SERVICE
    default 5
    range 0 15

config SKYWALKER_COMMAND_PERIOD_MS
    int "Command arbitration period in milliseconds"
    depends on SKYWALKER_COMMAND_SERVICE
    default 10
    range 1 1000

config SKYWALKER_ROBOTICS_SWERVE
    bool "Four module swerve controller and bench power limiter"
    default y
    depends on SKYWALKER_LIB_ROBOTICS

config SKYWALKER_ROBOTICS_GIMBAL
    bool "Recoverable yaw gimbal"
    depends on SKYWALKER_LIB_ROBOTICS && SKYWALKER_LIB_MOTOR_CONTROL

config SKYWALKER_ATTITUDE_EKF
    bool "Instance-owned quaternion attitude EKF"
    depends on CPP
    select SKYWALKER_LIB_CONTROL

config SKYWALKER_VISION
    bool "Independent vision link"
    depends on SKYWALKER_LIB_COMMUNICATION

config SKYWALKER_VISION_AB
    bool "RM2026 AutoAim AB protocol"
    depends on SKYWALKER_VISION

config SKYWALKER_VISION_RECEIVER
    bool "Threaded vision UART receiver"
    depends on SKYWALKER_VISION && SKYWALKER_UART_TRANSPORT

config SKYWALKER_VISION_RX_STACK_SIZE
    int "Vision receiver stack bytes"
    depends on SKYWALKER_VISION_RECEIVER
    default 4096
    range 2048 16384

config SKYWALKER_VISION_RX_PRIORITY
    int "Vision receiver thread priority"
    depends on SKYWALKER_VISION_RECEIVER
    default 6
    range 0 15

endmenu
