#include "../../samples/robotics/common/vehicle_mc02.overlay"

/* USART10 interboard link, UART7 diagnostic console. */
/ {
    aliases {
        interboard-uart = &usart10;
        /delete-property/ telemetry-uart;
    };

    chosen {
        zephyr,console = &uart7;
        zephyr,shell-uart = &uart7;
    };

    // MC02 Power_5V_EN: shared external 5 V rail, including CAN3 connector power.
    external_5v: regulator-external-5v {
        compatible = "regulator-fixed";
        regulator-name = "EXTERNAL_5V";
        regulator-min-microvolt = <5000000>;
        regulator-max-microvolt = <5000000>;
        enable-gpios = <&gpioc 15 GPIO_ACTIVE_HIGH>;
        regulator-boot-on;
    };
};

&usart10 {
    status = "okay";
    current-speed = <460800>;
    data-bits = <8>;
    parity = "none";
    stop-bits = "1";
    dmas = <&dmamux1 3 119 STM32_DMA_PERIPH_TX>,
           <&dmamux1 4 118 STM32_DMA_PERIPH_RX>;
    dma-names = "tx", "rx";
};

/* UART7 is reserved for logs; remap vision-uart before enabling vision. */
&uart7 {
    status = "okay";
    current-speed = <115200>;
    data-bits = <8>;
    parity = "none";
    stop-bits = "1";
    /delete-property/ dmas;
    /delete-property/ dma-names;
};
