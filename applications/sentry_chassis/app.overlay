/* The eight motor configurations and CAN assignments live in board_config.hpp.
 * Keep connections_configured false until physical wiring, GM6020 current mode,
 * zero positions, directions, and power behavior have been checked.
 */
/ {
    aliases {
        interboard-uart = &usart1;
    };
};
&usart1 { current-speed = <460800>; };

/* Hardware entropy supplies a new interboard boot context after every reset. */
&rng { status = "okay"; };
