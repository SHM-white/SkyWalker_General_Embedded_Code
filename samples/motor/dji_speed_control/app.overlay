/ {
    aliases {
        motor0 = &gm6020_7;
    };

    gm6020_7: motor-7 {
        compatible = "dji,gm6020-current";
        status = "okay";
        can-bus = <&can1>;
        motor-id = <7>;

        /*
         * Same bench GM6020 as samples/motor/dji_unified.  The software
         * current clamp in main.cpp is +/- 3000 mA; keep the device boundary
         * equal so the closed loop is never rejected by setCurrent().
         */
        current-limit-ma = <3000>;

        /* GM6020 on this bench is direct drive: no gearbox. */
        gear-ratio-num = <1>;
        gear-ratio-den = <1>;

        /* Requires firmware >=1.0.11.2 with the current loop enabled. */
        current-loop-confirmed;
    };
};
