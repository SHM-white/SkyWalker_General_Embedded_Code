/* MC02 supplies can1, can2, remote-uart (UART5), telemetry-uart (USART1)
 * and the console (USART10). Keep transport ownership separate.
 * Hardware model, IDs, calibration and limits live in src/board_config.hpp.
 */
/ {
    aliases {
        vision-uart = &uart7;
        referee-uart = &usart1;
    };
};
/* DMA: SPI2 owns 1/2, UART7 uses 5/7, UART5 uses 6, head RX uses 8. */
&uart7 {
    current-speed = <115200>;
    dmas = <&dmamux1 5 80 STM32_DMA_PERIPH_TX>,
           <&dmamux1 7 79 STM32_DMA_PERIPH_RX>;
    dma-names = "tx", "rx";
};
&usart2 {
    current-speed = <1000000>;
    dmas = <&dmamux1 8 43 STM32_DMA_PERIPH_RX>;
    dma-names = "rx";
};
&usart1 { current-speed = <115200>; };
