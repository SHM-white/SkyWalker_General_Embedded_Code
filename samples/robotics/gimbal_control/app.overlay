/* CAN controllers and remote-uart are provided by the MC02 board DTS.
 * Motor model, IDs and limits are configured in src/board_config.hpp.
 */
/ {
    aliases {
        telemetry-uart = &cdc_acm_uart0;
    };
};

&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
        label = "VOFA";
    };
};
