/* USART1 is dedicated to board-to-board transport; use USART10 console for logs.
 * TODO(wiring): cloud head IMU uses MC02 rs485-2, RC uses UART5. */
/ { aliases { interboard-uart = &usart1; }; };
&usart1 { current-speed = <460800>; };
&can2 { status = "okay"; bitrate = <1000000>; };
&rng { status = "okay"; };
