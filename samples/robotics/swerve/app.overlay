/* Single module: motor IDs and CAN ports are configured in src/board_config.hpp.
 * CAN clocks/timing and remote UART configuration come from the board DTS,
 * matching dji_speed_control. Only USB telemetry is overridden here.
 */

/ {
    aliases {
        telemetry-uart = &cdc_acm_uart0;
    };
};

&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
        label = "VOFA";
    };
};
