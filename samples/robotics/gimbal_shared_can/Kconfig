mainmenu "Shared CAN mechanical bench"
config SHOOTER_INTERBOARD_BIG_YAW
    bool "Control chassis big Yaw over UART using the RC wheel, without IMU"
    depends on SKYWALKER_INTERBOARD_ENDPOINT && SKYWALKER_UART_TRANSPORT
    default n
    help
        Keep local gimbal/shooter controls and use the existing RC snapshot to
        send manual big-Yaw velocity. Pair with big_yaw_interboard chassis.conf.
        A lost peer revokes only the big-Yaw release gate.

config SHOOTER_UNLOADED_FEED
    bool "Permit unloaded dial indexing"
    default y
    help
        Empty mechanism only. Loaded shooting requires live heat and permission
        sources; these must be wired before disabling this bench bypass.
config SHOOTER_MOUSE_AIM_TELEMETRY
    bool "Use the 19-channel mouse/gimbal tuning telemetry layout"
    depends on SKYWALKER_LIB_VOFA
    default n
    help
        Replace shooter channels with raw mouse input, input age, cycle time,
        joint targets/feedback, effort, validity and saturation flags.
rsource "../common/sample_control.Kconfig"
source "Kconfig.zephyr"
