#include <zephyr/dt-bindings/dma/stm32_dma.h>
/* MC02 UART5: PD2 RX, PC12 TX. Confirm the board's DBUS/SBUS electrical path. */
/ { aliases { remote-uart = &uart5; }; };
&uart5 {
    status = "okay";
    current-speed = <100000>;
    data-bits = <8>;
    parity = "even";
    stop-bits = "1";
    dmas = <&dmamux1 5 66 STM32_DMA_PERIPH_TX>, <&dmamux1 6 65 STM32_DMA_PERIPH_RX>;
    dma-names = "tx", "rx";
};
