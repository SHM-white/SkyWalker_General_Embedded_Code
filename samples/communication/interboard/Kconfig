    prompt "Interboard transport selected at initialization"
    default BENCH_TRANSPORT_UART
config BENCH_TRANSPORT_UART
    bool "UART"
config BENCH_TRANSPORT_RS485
    bool "Two-wire RS485"
config BENCH_TRANSPORT_CAN
    bool "Classic CAN on dedicated CAN3"
endchoice

