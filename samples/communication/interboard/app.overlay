/* Connect board A PA9 -> board B PA10, board B PA9 -> board A PA10, and GND. */
/ {
    aliases {
        interboard-uart = &usart1;
        interboard-rs485 = &usart2;
        interboard-can = &can3;
    };
};

&usart1 {
    current-speed = <460800>;
};

/* MC02 hardware DE PD4, TX PD5, RX PD6; DMA uses the global board map. */
&usart2 {
    current-speed = <460800>;
};

&can3 {
    bitrate = <1000000>;
};

&rng {
    status = "okay";
};
