/ {
    aliases {
        telemetry-uart = &usart1;
    };
};
// Board alias rs485-2 already maps to this remapped USART2 (PD4/PD5/PD6).
// RX only: firmware never transmits configuration commands to the DM module.
&usart2 {
    current-speed = <1000000>;
    dmas = <&dmamux1 5 43 STM32_DMA_PERIPH_RX>;
    dma-names = "rx";
};
&usart1 {
    current-speed = <115200>;
};
