/ {
    aliases {
        telemetry-uart = &cdc_acm_uart0;
        imu-can = &can3;
    };

    // MC02 Power_5V_EN: shared external 5 V rail, including CAN3 connector power.
    external_5v: regulator-external-5v {
        compatible = "regulator-fixed";
        regulator-name = "EXTERNAL_5V";
        regulator-min-microvolt = <5000000>;
        regulator-max-microvolt = <5000000>;
        enable-gpios = <&gpioc 15 GPIO_ACTIVE_HIGH>;
        regulator-boot-on;
    };
};

&can3 { status = "okay"; bitrate = <1000000>; };

&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
        label = "VOFA";
    };
};

// Board alias rs485-2 already maps to this remapped USART2 (PD4/PD5/PD6).
// Firmware 2.x requires read requests; no configuration commands are sent.
&usart2 {
    current-speed = <2000000>;
    dmas = <&dmamux1 5 43 STM32_DMA_PERIPH_RX>,
           <&dmamux1 7 44 STM32_DMA_PERIPH_TX>;
    dma-names = "rx", "tx";
};

