#include "common.overlay"
/ {
    aliases {
        interboard-uart = &usart10;
        imu-can = &can3;
        /* Vision link: USB CDC ACM on PA11/PA12 (full speed), declared by the
         * board DTS. No DMA and no separate UART pin is consumed. */
        vision-uart = &cdc_acm_uart0;
        /* Navigation: USART1 PA9/PA10, 115200 8N1. DMA is reassigned below
         * because the board's default channels belong to USART10. */
        navigation-uart = &usart1;
    };
    external_5v: regulator-external-5v {
        compatible = "regulator-fixed";
        regulator-name = "EXTERNAL_5V";
        regulator-min-microvolt = <5000000>;
        regulator-max-microvolt = <5000000>;
        enable-gpios = <&gpioc 15 GPIO_ACTIVE_HIGH>;
        regulator-boot-on;
    };
};
/*
 * DMA inventory on this board (DMAMUX1 channels are the scarce resource):
 *   ch1/ch2  SPI2  (BMI088)          ch3/ch4  USART10 (interboard 460800)
 *   ch6      UART5 (DBUS RX)         ch9/ch10 USART3  (referee)
 *   ch5/ch7  USART1 (navigation)     ch0, 8, 11..15 free
 * The board default gave USART1 ch3/ch4, which belong to USART10 here, so its
 * DMA is reassigned to free channels instead of being dropped. Request IDs stay
 * fixed: USART1_TX = 42, USART1_RX = 41.
 */
&usart1 {
    status = "okay";
    current-speed = <115200>;
    data-bits = <8>;
    parity = "none";
    stop-bits = "1";
    dmas = <&dmamux1 5 42 STM32_DMA_PERIPH_TX>,
           <&dmamux1 7 41 STM32_DMA_PERIPH_RX>;
    dma-names = "tx", "rx";
};
&usart10 {
    status = "okay";
    current-speed = <460800>;
    data-bits = <8>;
    parity = "none";
    stop-bits = "1";
    dmas = <&dmamux1 3 119 STM32_DMA_PERIPH_TX>,
           <&dmamux1 4 118 STM32_DMA_PERIPH_RX>;
    dma-names = "tx", "rx";
};
/* Existing onboard RS485 transceiver; the referee's TTL output needs a
 * matching electrical adapter before it can reach this USART3 input. */
&usart3 {
    status = "okay";
    current-speed = <115200>;
    data-bits = <8>;
    parity = "none";
    stop-bits = "1";
};
