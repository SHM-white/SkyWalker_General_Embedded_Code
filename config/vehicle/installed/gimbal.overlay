#include "common.overlay"
/ {
    aliases {
        interboard-uart = &usart10;
        imu-can = &can3;
    };
    external_5v: regulator-external-5v {
        compatible = "regulator-fixed";
        regulator-name = "EXTERNAL_5V";
        regulator-min-microvolt = <5000000>;
        regulator-max-microvolt = <5000000>;
        enable-gpios = <&gpioc 15 GPIO_ACTIVE_HIGH>;
        regulator-boot-on;
    };
};
/* DMA1 1/2 are reserved for the board IMU. USART1 must release 3/4. */
&usart1 {
    /delete-property/ dmas;
    /delete-property/ dma-names;
};
&usart10 {
    status = "okay";
    current-speed = <460800>;
    data-bits = <8>;
    parity = "none";
    stop-bits = "1";
    dmas = <&dmamux1 3 119 STM32_DMA_PERIPH_TX>,
           <&dmamux1 4 118 STM32_DMA_PERIPH_RX>;
    dma-names = "tx", "rx";
};
